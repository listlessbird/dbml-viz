{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dbml-viz",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-04-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"services": [
		{
			"binding": "SCHEMA_PARSER",
			"service": "dbml-viz-parser"
		}
	],
	"queues": {
		"producers": [
			{
				"queue": "dbml-viz-og-img-queue",
				"binding": "OG_QUEUE"
			}
		]
	},
	"kv_namespaces": [
		{
			"binding": "SCHEMAS",
			"id": "e15c9a5148d14010a38d5761729f3725",
			"remote": true
		},
		{
			"binding": "OG_STATUS",
			"id": "106ac408c41e43e9a721de058ce72018",
			"remote": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "SchemaWorkspace",
				"class_name": "SchemaWorkspace"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"SchemaSessionDO"
			]
		},
		{
			"tag": "v2",
			"deleted_classes": [
				"SchemaSessionDO"
			],
			"new_sqlite_classes": [
				"SchemaWorkspace"
			]
		}
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/og/*",
			"/s/*",
			"/api/*"
		]
	},
	"r2_buckets": [
		{
			"bucket_name": "dbml-viz-dynamic-ogs",
			"binding": "OG_IMAGES",
			"remote": true
		}
	]
}